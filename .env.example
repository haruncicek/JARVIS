# Bu dosyayı .env olarak kopyalayın. Gerçek değerleri ASLA depoya yüklemeyin.

# Kullanıcı
JARVIS_USER_NAME=Harun
JARVIS_LANGUAGE=tr

# Davranış
JARVIS_TONE=sakin-net-pratik-kuru-espirili
JARVIS_REQUIRE_APPROVAL=true
JARVIS_EMAIL_REPLY_ALLOWED=false

# Gmail (salt okuma)
GMAIL_ACCESS_MODE=read_only

# GitHub
GITHUB_OWNER=haruncicek
GITHUB_REPO=JARVIS

# Gizli anahtarlar (doldurun, paylaşmayın)
ANTHROPIC_API_KEY=
